{
    "openapi": "3.1.0",
    "info": {
        "title": "Embedding Service",
        "version": "2.0.0"
    },
    "paths": {
        "/models": {
            "get": {
                "tags": [
                    "Models"
                ],
                "summary": "Get Models",
                "description": "Список моделей с их статусами.",
                "operationId": "get_models_models_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ModelsListResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/models/{model_name}/load": {
            "post": {
                "tags": [
                    "Models"
                ],
                "summary": "Load Model",
                "description": "Загружает модель в память GPU.",
                "operationId": "load_model_models__model_name__load_post",
                "parameters": [
                    {
                        "name": "model_name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Model Name"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoadUnloadResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/models/{model_name}/unload": {
            "post": {
                "tags": [
                    "Models"
                ],
                "summary": "Unload Model",
                "description": "Выгружает модель из памяти.",
                "operationId": "unload_model_models__model_name__unload_post",
                "parameters": [
                    {
                        "name": "model_name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Model Name"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoadUnloadResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/embeddings": {
            "post": {
                "tags": [
                    "Embeddings"
                ],
                "summary": "Create Task",
                "description": "Создаёт задачу на вычисление эмбеддинга.",
                "operationId": "create_task_embeddings_post",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ComputeRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskShortResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "tags": [
                    "Embeddings"
                ],
                "summary": "List Tasks",
                "operationId": "list_tasks_embeddings_get",
                "parameters": [
                    {
                        "name": "status_filter",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "Status Filter"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TasksListResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/embeddings/{task_id}": {
            "get": {
                "tags": [
                    "Embeddings"
                ],
                "summary": "Get Task",
                "description": "Получение информации о задаче.",
                "operationId": "get_task_embeddings__task_id__get",
                "parameters": [
                    {
                        "name": "task_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Task Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskDetailResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Embeddings"
                ],
                "summary": "Delete Task",
                "description": "Удаляет задачу (только незавершённые и не выполняющиеся).",
                "operationId": "delete_task_embeddings__task_id__delete",
                "parameters": [
                    {
                        "name": "task_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Task Id"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Successful Response"
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ComputeRequest": {
                "properties": {
                    "text": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Text"
                    },
                    "model_name": {
                        "type": "string",
                        "title": "Model Name"
                    }
                },
                "type": "object",
                "required": [
                    "text",
                    "model_name"
                ],
                "title": "ComputeRequest"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LoadUnloadResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "message": {
                        "type": "string",
                        "title": "Message"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "message"
                ],
                "title": "LoadUnloadResponse"
            },
            "ModelInfo": {
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "max_length": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Max Length"
                    }
                },
                "type": "object",
                "required": [
                    "name",
                    "status"
                ],
                "title": "ModelInfo"
            },
            "ModelsListResponse": {
                "properties": {
                    "models": {
                        "items": {
                            "$ref": "#/components/schemas/ModelInfo"
                        },
                        "type": "array",
                        "title": "Models"
                    }
                },
                "type": "object",
                "required": [
                    "models"
                ],
                "title": "ModelsListResponse"
            },
            "TaskDetailResponse": {
                "properties": {
                    "task_id": {
                        "type": "string",
                        "title": "Task Id"
                    },
                    "model_name": {
                        "type": "string",
                        "title": "Model Name"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "result": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "number"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Result"
                    },
                    "error": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Error"
                    },
                    "processing_time_ms": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Processing Time Ms"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At"
                    },
                    "completed_at": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Completed At"
                    }
                },
                "type": "object",
                "required": [
                    "task_id",
                    "model_name",
                    "status",
                    "created_at"
                ],
                "title": "TaskDetailResponse"
            },
            "TaskShortResponse": {
                "properties": {
                    "task_id": {
                        "type": "string",
                        "title": "Task Id"
                    },
                    "model_name": {
                        "type": "string",
                        "title": "Model Name"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At"
                    }
                },
                "type": "object",
                "required": [
                    "task_id",
                    "model_name",
                    "status",
                    "created_at"
                ],
                "title": "TaskShortResponse"
            },
            "TasksListResponse": {
                "properties": {
                    "tasks": {
                        "items": {
                            "$ref": "#/components/schemas/TaskShortResponse"
                        },
                        "type": "array",
                        "title": "Tasks"
                    }
                },
                "type": "object",
                "required": [
                    "tasks"
                ],
                "title": "TasksListResponse"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}