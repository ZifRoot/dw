{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "debug": "vite --port 3000",
    "release": "npm run build:release && npm run run:release",
    "build:release": "npm run typecheck && vite build --mode production",
    "run:release": "npm run preview",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "typecheck-file": "tsc --noEmit --noUnusedLocals false --noUnusedParameters false > error.log 2>&1",
    "format": "prettier --write"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "d3": "^7.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/css-modules": "^1.0.5",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^4.0.0",
    "vite-plugin-importmap": "^0.1.1",
    "vite-tsconfig-paths": "^6.1.1"
  }
}