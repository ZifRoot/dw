{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "ES2025",
      "DOM",
      "DOM.Iterable",
      "esnext.typedarrays"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@utils/*": [
        "src/shared/utils/*"
      ],
      "@clients/*": [
        "src/clients/*"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@domain/*": [
        "src/Domain/*"
      ],
      "@Scene/*": [
        "src/core/Scene/*"
      ],
      "@models/*": [
        "src/models/*"
      ],
      "@ui/*": [
        "src/ui/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
