{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:up": "ts-node src/db/db-manager.ts up",
    "docker:down": "ts-node src/db/db-manager.ts down",
    "debug": "tsx watch --inspect=5858 -r tsconfig-paths/register src/index.ts",
    "release": "npm run build:release && npm run run:release",
    "build:release": "tsc -p tsconfig.release.json && tsc-alias -p tsconfig.release.json",
    "typecheck": "tsc --noEmit",
    "run:release": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "hono": "^4.12.19",
    "pg": "^8.21.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.3",
    "@electric-sql/pglite": "^0.5.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "pg-copy-streams-binary": "^2.2.0"
  }
}
