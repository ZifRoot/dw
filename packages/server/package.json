{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:up": "ts-node src/db/db-manager.ts up",
    "docker:down": "ts-node src/db/db-manager.ts down",
    "debug": "ts-node --inspect=9229 -r tsconfig-paths/register src/index.ts",
    "build:release": "tsc -p tsconfig.release.json",
    "release:server": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/zod-openapi": "^1.4.0",
    "express": "^5.2.1",
    "hono": "^4.12.19",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2"
  }
}
