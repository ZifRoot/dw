{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "esnext.typedarrays"],
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@embedder": ["src/clients/embedder/axios"],
      "@utils/*": ["src/shared/utils/*"],
      "@models/*": ["src/db/models/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/clients/embedder/fetch/**/*"
  ]
}
