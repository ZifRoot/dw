{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2020",
    "lib": ["es2022", "ES2025", "DOM"],
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@embedder": ["src/clients/embedder/axios"],
      "@utils/*": ["src/shared/utils/*"],
      "@models/*": ["src/db/models/*"],
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}