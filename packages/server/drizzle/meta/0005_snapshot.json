        }
      },
      "definition": "\n    SELECT COALESCE(avg.model_name, med.model_name) AS model_name,\n           avg.avg_bytes_per_ms,\n           med.median_bytes_per_ms,\n           LEAST(COALESCE(avg.avg_bytes_per_ms, med.median_bytes_per_ms), COALESCE(med.median_bytes_per_ms, avg.avg_bytes_per_ms)) AS min_bytes_per_ms\n    FROM model_avg_speed avg\n    FULL JOIN model_median_speed med ON avg.model_name::text = med.model_name::text\n  ",
      "name": "model_speeds",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
