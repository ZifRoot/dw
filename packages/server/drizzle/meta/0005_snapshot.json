  "views": {
    "public.distinct_models": {
      "columns": {
        "model_name": {
          "name": "model_name",
          "type": "varchar(80)",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select distinct \"model_name\" from \"embeddings\"",
      "name": "distinct_models",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.model_avg_speed": {
      "columns": {
        "model_name": {
          "name": "model_name",
          "type": "varchar",
          "primaryKey": false,
          "notNull": false
        },
        "avg_bytes_per_ms": {
          "name": "avg_bytes_per_ms",
          "type": "real",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n    SELECT session_throughput.model_name,\n           CASE\n               WHEN sum(session_throughput.processing_time_ms) > 0::double precision \n               THEN sum(session_throughput.total_bytes)::double precision / sum(session_throughput.processing_time_ms)\n               ELSE NULL::double precision\n           END AS avg_bytes_per_ms\n    FROM session_throughput\n    GROUP BY session_throughput.model_name\n  ",
      "name": "model_avg_speed",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.model_efficiency": {
      "columns": {
        "model_name": {
          "name": "model_name",
          "type": "varchar",
          "primaryKey": false,
          "notNull": false
        },
        "avg_ms_per_byte": {
          "name": "avg_ms_per_byte",
          "type": "real",
          "primaryKey": false,
          "notNull": false
        },
        "median_ms_per_byte": {
          "name": "median_ms_per_byte",
          "type": "real",
          "primaryKey": false,
          "notNull": false
        },
        "sample_count": {
          "name": "sample_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n    WITH session_sizes AS (\n         SELECT message_fragments.session_id,\n                sum(message_fragments.size) AS total_size\n         FROM message_fragments\n         GROUP BY message_fragments.session_id\n    ), model_processed AS (\n         SELECT e.model_name,\n                e.session_id,\n                e.processing_time_ms,\n                ss.total_size\n         FROM embeddings e\n         JOIN session_sizes ss ON e.session_id = ss.session_id\n         WHERE ss.total_size > 0\n    )\n    SELECT model_processed.model_name,\n           avg(model_processed.processing_time_ms / model_processed.total_size::double precision) AS avg_ms_per_byte,\n           percentile_cont(0.5::double precision) WITHIN GROUP (ORDER BY (model_processed.processing_time_ms / model_processed.total_size::double precision)) AS median_ms_per_byte,\n           count(*) AS sample_count\n    FROM model_processed\n    GROUP BY model_processed.model_name\n  ",
      "name": "model_efficiency",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.model_median_speed": {
      "columns": {
        "model_name": {
          "name": "model_name",
          "type": "varchar",
          "primaryKey": false,
          "notNull": false
        },
        "median_bytes_per_ms": {
          "name": "median_bytes_per_ms",
          "type": "real",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n    SELECT session_throughput.model_name,\n           percentile_cont(0.5::double precision) WITHIN GROUP (ORDER BY session_throughput.bytes_per_ms) AS median_bytes_per_ms\n    FROM session_throughput\n    WHERE session_throughput.bytes_per_ms IS NOT NULL\n    GROUP BY session_throughput.model_name\n  ",
      "name": "model_median_speed",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.model_pending_bytes": {
      "columns": {
        "model_name": {
          "name": "model_name",
          "type": "varchar",
          "primaryKey": false,
          "notNull": false
        },
        "pending_bytes": {
          "name": "pending_bytes",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n    SELECT dm.model_name,\n           COALESCE(( SELECT sum(sts.total_bytes) AS sum\n                      FROM session_total_size sts\n                      WHERE NOT (EXISTS ( SELECT 1\n                                          FROM embeddings e\n                                          WHERE e.session_id = sts.session_id \n                                            AND e.model_name::text = dm.model_name::text))), 0::numeric) AS pending_bytes\n    FROM distinct_models dm\n  ",
      "name": "model_pending_bytes",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
