      "definition": "select \"chat_sessions\".\"id\", \"chat_sessions\".\"title\", \"embeddings\".\"model_name\" from \"chat_sessions\" inner join \"embeddings\" on \"chat_sessions\".\"id\" = \"embeddings\".\"session_id\" where \"chat_sessions\".\"updated_at\" > \"embeddings\".\"created_at\"",
