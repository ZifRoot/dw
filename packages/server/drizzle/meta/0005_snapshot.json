      "definition": "\n  SELECT \n    e.model_name,\n    e.session_id,\n    sts.total_bytes,\n    e.processing_time_ms,\n    CASE \n      WHEN e.processing_time_ms > 0 \n      THEN sts.total_bytes::double precision / e.processing_time_ms \n      ELSE NULL \n    END AS speed_bytes_per_ms\n  FROM embeddings e\n  JOIN session_total_size sts ON e.session_id = sts.session_id\n",
