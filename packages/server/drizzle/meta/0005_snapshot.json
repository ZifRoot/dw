    "public.speedx": {
      "columns": {
        "model_name": {
          "name": "model_name",
          "type": "varchar",
          "primaryKey": false,
          "notNull": false
        },
        "total_data_size": {
          "name": "total_data_size",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "total_time_ms": {
          "name": "total_time_ms",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "speed_size_per_ms": {
          "name": "speed_size_per_ms",
          "type": "real",
          "primaryKey": false,
          "notNull": false
        },
        "speed_size_per_sec": {
          "name": "speed_size_per_sec",
          "type": "real",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n    WITH session_size AS (\n         SELECT cs.id,\n                COALESCE(fs.sum_frag, 0::bigint) + COALESCE(fls.sum_file, 0::bigint) AS size\n         FROM chat_sessions cs\n         LEFT JOIN ( SELECT message_fragments.session_id,\n                            sum(message_fragments.size) AS sum_frag\n                     FROM message_fragments\n                     GROUP BY message_fragments.session_id ) fs ON cs.id = fs.session_id\n         LEFT JOIN ( SELECT mf.session_id,\n                            sum(f.file_size) AS sum_file\n                     FROM message_files mf\n                     JOIN files f ON mf.file_id = f.id\n                     GROUP BY mf.session_id ) fls ON cs.id = fls.session_id\n    )\n    SELECT e.model_name,\n           sum(ss.size) AS total_data_size,\n           sum(e.processing_time_ms) AS total_time_ms,\n           sum(ss.size)::double precision / NULLIF(sum(e.processing_time_ms), 0::double precision) AS speed_size_per_ms,\n           sum(ss.size)::double precision / NULLIF(sum(e.processing_time_ms), 0::double precision) * 1000::double precision AS speed_size_per_sec\n    FROM embeddings e\n    JOIN session_size ss ON e.session_id = ss.id\n    GROUP BY e.model_name\n    ORDER BY (sum(ss.size)::double precision / NULLIF(sum(e.processing_time_ms), 0::double precision)) DESC\n  ",
      "name": "speedx",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
