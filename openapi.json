{
  "openapi": "3.0.0",
  "info": {
    "title": "Embedding API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081/api"
    }
  ],
  "paths": {
    "/documents": {
      "get": {
        "summary": "Список документов",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/document/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Документ"
          }
        }
      }
    },
    "/document/{id}/text": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Текст"
          }
        }
      }
    },
    "/document/{id}/fragment/{fragment_id}/text": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "name": "fragment_id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Фрагмент"
          }
        }
      }
    },
    "/embeddings/{id}": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/update": {
      "get": {
        "summary": "Запустить обновление",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}