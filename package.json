{
  "name": "deepseek-w",
  "version": "1.0.0",
  "description": "To make it easy for you to get started with GitLab, here's a list of recommended next steps.",
  "homepage": "https://gitlab.com/yakov.norev/deepseek-w#readme",
  "bugs": {
    "url": "https://gitlab.com/yakov.norev/deepseek-w/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/yakov.norev/deepseek-w.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build-watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "debug": "ts-node --inspect src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "npm run docker:up && prisma migrate dev",
    "docker:up": "ts-node src/db/db-manager.ts up",
    "docker:down": "ts-node src/db/db-manager.ts down"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "nodemon": "^3.1.14",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.20.0",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2"
  }
}
