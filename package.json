{
  "name": "dw",
  "version": "1.0.0",
  "description": "DW — client, server and shared source project.",
  "homepage": "https://github.com/ZifRoot/dw#readme",
  "bugs": {
    "url": "https://github.com/ZifRoot/dw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZifRoot/dw.git"
  },
  "license": "ISC",
  "author": "ZifRoot",
  "private": true,
  "workspaces": [
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "link:shared": "bash ./scripts/link-shared.sh",
    "generate:all": "npm run generate:dew && npm run generate:embedder",
    "generate:dew": "cd generators\\dew && generate.cmd",
    "generate:embedder": "cd generators\\embedder && generate.cmd",
    "generate-api": "cd ./generators/embedder && openapi-generator-cli batch ./configs/axios.json",
    "debug:server": "npm --workspace server run debug",
    "debug:client": "npm --workspace client run debug",
    "release:server": "npm --workspace server run release",
    "release:client": "npm --workspace client run release",
    "build:server:release": "npm --workspace server run build:release",
    "build:client:release": "npm --workspace client run build:release",
    "build:release": "npm run build:client:release && npm run build:server:release",
    "typecheck:server": "npm --workspace server run typecheck",
    "typecheck:client": "npm --workspace client run typecheck",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "db:generate": "npm --workspace server run db:generate",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:push": "npm --workspace server run db:push",
    "db:studio": "npm --workspace server run db:studio",
    "docker:up": "npm --workspace server run docker:up",
    "docker:down": "npm --workspace server run docker:down",
    "clean": "rm -rf packages/client/src/api packages/server/src/api packages/client/dist packages/server/dist",
    "run:release:server": "npm --workspace server run run:release",
    "run:release:client": "npm --workspace client run run:release",
    "preview:client": "npm --workspace client run preview",
    "typecheck-file:client": "npm --workspace client run typecheck-file",
    "format:client": "npm --workspace client run format",
    "typecheck:tests": "tsc -p test/tsconfig.json",
    "test": "tsx --tsconfig test/tsconfig.json --test test/index.ts"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@openapitools/openapi-generator-cli@2.41.0": true
  }
}
