{
  "version": "2.0.0",
  "tasks": [
    // ========== DEBUG (отладка) ==========
    {
      "label": "debug:server",
      "type": "npm",
      "script": "debug:server",
      "path": "${workspaceFolder}",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^(.*)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Server running on http://localhost:.*",
          "endsPattern": ".*listening.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "debug:client",
      "type": "npm",
      "script": "debug:client",
      "path": "${workspaceFolder}",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^(.*)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v\\d+\\.\\d+\\.\\d+",
          "endsPattern": "ready in \\d+ms"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },

    // ========== GENERATE (для API) ==========
    {
      "label": "generate:server",
      "type": "npm",
      "script": "generate:server",
      "path": "${workspaceFolder}",
      "problemMatcher": []
    },
    {
      "label": "generate:client",
      "type": "npm",
      "script": "generate:client",
      "path": "${workspaceFolder}",
      "problemMatcher": []
    },

    // ========== BUILD (release) ==========
    {
      "label": "build:server:release",
      "type": "npm",
      "script": "build:server:release",
      "path": "${workspaceFolder}",
      "dependsOn": ["generate:server"],
      "dependsOrder": "sequence",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build:client:release",
      "type": "npm",
      "script": "build:client:release",
      "path": "${workspaceFolder}",
      "dependsOn": ["generate:client"],
      "dependsOrder": "sequence",
      "problemMatcher": ["$tsc"]
    },

    // ========== RELEASE (запуск скомпилированного кода) ==========
    {
      "label": "release:server",
      "type": "npm",
      "script": "release:server",
      "path": "${workspaceFolder}",
      "isBackground": true,
      "dependsOn": ["build:server:release"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "pattern": { "regexp": "^(.*)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Server running on http://localhost:.*",
          "endsPattern": ".*listening.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "release:client",
      "type": "npm",
      "script": "release:client",
      "path": "${workspaceFolder}",
      "isBackground": true,
      "dependsOn": ["build:client:release"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "pattern": { "regexp": "^(.*)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Local:.*http://localhost:.*",
          "endsPattern": ".*press h to show help.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
