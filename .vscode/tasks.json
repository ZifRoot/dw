{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:client",
      "type": "npm",
      "script": "dev",
      "path": "${workspaceFolder}/client",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v\\d+\\.\\d+\\.\\d+",
          "endsPattern": "ready in \\d+ms"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "dev:server",
      "type": "npm",
      "script": "dev",
      "path": "${workspaceFolder}/src/server",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Listening on port",
          "endsPattern": "Server started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "build:client",
      "type": "npm",
      "script": "build",
      "path": "${workspaceFolder}/client",
      "group": "build",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build:server",
      "type": "npm",
      "script": "build",
      "path": "${workspaceFolder}/server",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "start:client",
      "type": "npm",
      "script": "preview",
      "path": "${workspaceFolder}/client",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "➜  Local:",
          "endsPattern": "press h to show help"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "prod"
      }
    },
    {
      "label": "start:server",
      "type": "npm",
      "script": "start",
      "path": "${workspaceFolder}/server",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Listening on port",
          "endsPattern": "Server started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "prod"
      }
    },
    {
      "label": "build:all",
      "dependsOn": ["build:client", "build:server"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "rebuild:all",
      "dependsOn": ["clean:all", "build:all"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "clean:client",
      "type": "shell",
      "command": "rm -rf dist",
      "options": {
        "cwd": "${workspaceFolder}/client"
      }
    },
    {
      "label": "clean:server",
      "type": "shell",
      "command": "rm -rf dist",
      "options": {
        "cwd": "${workspaceFolder}/server"
      }
    },
    {
      "label": "clean:all",
      "dependsOn": ["clean:client", "clean:server"],
      "dependsOrder": "parallel"
    }
  ]
}
