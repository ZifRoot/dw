{
  "version": "0.2.0",

  "configurations": [
    {
      "name": "Debug: Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "debug:server"
    },
    {
      "name": "Debug: Client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/packages/client/src",
      "preLaunchTask": "debug:client"
    },
    {
      "name": "Release: Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/server/dist/index.js",
      "preLaunchTask": "release:server"
    },
    {
      "name": "Release: Client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}/packages/client/dist",
      "preLaunchTask": "release:client"
    }
  ],
  "compounds": [
    {
      "name": "Debug Fullstack",
      "configurations": ["Debug: Server", "Debug: Client"],
      "stopAll": true
    },
    {
      "name": "Release Fullstack",
      "configurations": ["Release: Server", "Release: Client"],
      "stopAll": true
    }
  ]
}
